{
    "name": "Require verified cosign signature at deployment",
    "description": "No business workload can be deployed with an image lacking a cosign signature verifiable with the pipeline public key.",
    "rationale": "Ensures image integrity and provenance: only images signed by the authorized pipeline are allowed to run.",
    "remediation": "Sign the image with cosign using the pipeline key and verify that the signature was published to the registry.",
    "disabled": false,
    "categories": [
        "Security Best Practices"
    ],
